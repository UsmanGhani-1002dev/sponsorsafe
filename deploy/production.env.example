APP_NAME=SponsorSafe
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.yourdomain.co.uk
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sponsorsafe
DB_USERNAME=sponsorsafe
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Email through your hosting's mail server (cPanel → Email Accounts: create no-reply@yourdomain.co.uk,
# then "Connect Devices" shows these settings). Port 465 needs MAIL_SCHEME=smtps; port 587 leaves it empty.
# In cPanel → Email Deliverability, make sure SPF and DKIM show "Valid", or emails go to spam.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.yourdomain.co.uk
MAIL_PORT=465
MAIL_USERNAME="no-reply@yourdomain.co.uk"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@yourdomain.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

# Super admin: choose a long random path and list the IPs allowed to open it (comma-separated).
OPS_PATH=ops-change-this-to-something-random
OPS_ALLOWED_IPS=

# Website enquiries are emailed here; also the contact address in the privacy policy and terms.
SUPPORT_EMAIL=support@yourdomain.co.uk

# Who runs the service, shown in the privacy policy, terms and employee privacy notice. Leave a line empty
# to leave it out. The ICO number is your data protection registration (ico.org.uk).
COMPANY_NAME="Enovtec Ltd"
COMPANY_NUMBER=
COMPANY_ADDRESS="Southampton, United Kingdom"
COMPANY_ICO_NUMBER=
